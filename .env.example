# ============================================================
# 复制为 .env 后按需修改。生产环境必须替换所有占位值与默认口令。
# 注意：.env 已被根 .gitignore 忽略，不要提交真实密钥。
# ============================================================

# ---------- 必填 ----------
# 占位值约定：密钥/口令类一律留空，运行时/启动期显式报错，而非拿假值默默跑。
# 留空会导致启动失败（JWT_SECRET / MONGODB_URI / CORS_ORIGIN 生产必填）。
JWT_SECRET=
# access token 时效：建议 15m，生产环境不允许超过 1h（启动期硬校验）。
# 续期由 refresh token 承担，不要为了"少刷新"而拉长。
JWT_EXPIRATION=15m
# refresh token 时效（服务端存储、用一次即轮换、可吊销）
JWT_REFRESH_TTL=30d
MONGODB_URI=mongodb://root:<mongo-root-password>@mongodb:27017/math_llm_tutor?authSource=admin

# 生产环境必填：逗号分隔的允许来源（缺失会拒绝启动，避免 CORS 全放行）
# 含 80 端口来源：前端容器默认发布在 :80。默认部署走 nginx 同源反代 /api/**，
# 其实不产生跨域；这里保留直连后端端口的场景（本机调试、旧版前端）。
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:8080,http://localhost:5173

# 前端请求的 API 基址（构建期注入前端镜像，见 docker-compose 的 args）。
# 默认 /api = 走 nginx 同源反代，无跨域、无需对外暴露后端端口。
# 若前端与后端分离部署到不同域，改成后端的绝对地址（届时必须把该域加进 CORS_ORIGIN）。
API_BASE_URL=/api

# 反向代理信任策略，默认 1（compose 中 nginx 是后端唯一上游）。
# 语义同 Express trust proxy：1=信任最近一跳。**留空 = 完全不信任 X-Forwarded-For**，
# 此时经 nginx 进来的请求 req.ip 会退化为 nginx 容器地址，全站用户被算作同一限流来源。
# 注意：开启的前提是后端端口不对不可信来源暴露（compose 已绑定 127.0.0.1）。
TRUST_PROXY=1

# 生产环境默认不注册 Swagger 文档（会完整枚举含管理端的全部端点）。
ENABLE_SWAGGER=

# ---------- 数据库口令（生产环境必须更换，禁止沿用默认值） ----------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=<mongo-root-password>
REDIS_PASSWORD=<redis-password>
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>

# ---------- 服务地址 ----------
SYMPY_SERVICE_URL=http://sympy-service:8000
# SymPy 计算端点要求携带的内部令牌（后端与 sympy-service 必须一致）
SYMPY_INTERNAL_TOKEN=<sympy-internal-token>
# 单次符号计算超时（秒）；客户端超时默认 20000ms，可再调
SYMPY_COMPUTE_TIMEOUT_SECONDS=12
SYMPY_TIMEOUT_MS=20000
REDIS_HOST=redis
REDIS_PORT=6379
NEO4J_URI=bolt://neo4j:7687

# ---------- AI 能力（缺失时智能体降级为本地规则引擎） ----------
# 占位值约定：密钥类一律留空，缺失时运行时显式降级，而非拿"看起来能用"的假值默默跑。
# 注意：根级用 DEEPSEEK_API_KEY（ai-solver 旧直连模块读取），
# 多智能体链路（ai-models.service）读 AI_DEEPSEEK_API_KEY，两者都留空即可。
AI_GLM_API_KEY=
AI_GPT_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=

# ---------- 限流 ----------
# /agents/* 的 LLM 调用限流（默认 5 分钟 20 次/IP，连续跑自检会触发）
RATE_LIMIT_LLM_MAX_REQUESTS=20
RATE_LIMIT_LLM_WINDOW_MS=300000

# ---------- 登录防爆破与刷新宽容 ----------
# 同一账号连续失败达到 LOGIN_MAX_FAILURES 次后锁定 LOGIN_LOCK_SECONDS 秒
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
LOGIN_WINDOW_SECONDS=900
# refresh token 重放宽容窗口（秒）：多标签页/多设备并发刷新在窗口内视为
# 幂等重试并返回同一份新令牌；窗口外重复出现才判定为泄露并吊销令牌族
REFRESH_REPLAY_GRACE_SECONDS=30

# ---------- 运行参数 ----------
NODE_ENV=production
PORT=3000
KEEP_ALIVE_TIMEOUT_MS=65000
