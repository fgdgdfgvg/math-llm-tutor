      "exercise_types": ["求齐次方程通解", "求非齐次方程特解", "验证线性无关"],
      "latex_templates": [
        "y^{(n)}+a_1y^{(n-1)}+\\cdots+a_ny=0,\\ \\lambda^n+a_1\\lambda^{n-1}+\\cdots+a_n=0"
      ]
    },
    {
      "id": "constant_coeff_homogeneous",
      "name": "常系数齐次线性方程",
