      "exercise_types": ["标准一阶线性方程求解", "常数变易法求解", "含参数的线性方程"],
      "latex_templates": [
        "\\frac{dy}{dx}+P(x)y=Q(x),\\ \\mu=e^{\\int Pdx}"
      ]
    },
    {
      "id": "bernoulli_ode",
      "name": "伯努利方程",
      "description": "形如y'+P(x)y=Q(x)y^n (n≠0,1)的非线性方程，通过z=y^{1-n}变换化为线性方程",
      "formulas": [
        "y'+P(x)y=Q(x)y^n",
        "z=y^{1-n},\\ \\frac{dz}{dx}+(1-n)P(x)z=(1-n)Q(x)"
