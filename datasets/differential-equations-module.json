      "formulas": ["F(x,y,y',y'',...,y^{(n)})=0", "y^{(n)}=f(x,y,y',...,y^{(n-1)})"],
      "difficulty": "easy",
      "prerequisites": ["derivative_rules", "integral_methods"],
      "applications": ["物理建模", "工程问题", "生物种群模型", "经济学动态分析"],
      "common_mistakes": ["混淆通解与特解", "初始条件代入错误", "忽略解的存在区间"],
      "exercise_types": ["判断微分方程阶数", "验证函数是否为解", "由通解求特解"],
