      "difficulty": "medium",
      "prerequisites": ["first_order_linear_ode", "substitution_method"],
      "applications": ["人口增长的逻辑斯蒂模型", "化学反应动力学"],
      "common_mistakes": ["变换公式记忆错误", "忘记验证n=0和n=1的特殊情况"],
      "exercise_types": ["标准伯努利方程求解", "识别并化简为伯努利形式"],
      "latex_templates": [
        "y'+P(x)y=Q(x)y^n,\\ z=y^{1-n}"
      ]
    },
    {
      "id": "exact_ode",
      "name": "全微分方程（恰当方程）",
      "description": "形如P(x,y)dx+Q(x,y)dy=0满足∂P/∂y=∂Q/∂x的方程，存在势函数U(x,y)=C",
      "formulas": [
        "Pdx+Qdy=0,\\ \\frac{\\partial P}{\\partial y}=\\frac{\\partial Q}{\\partial x}",
        "U(x,y)=\\int Pdx+\\varphi(y),\\ \\frac{\\partial U}{\\partial y}=Q"
      ],
      "difficulty": "medium",
      "prerequisites": ["partial_derivatives", "integral_methods"],
      "applications": ["保守力场中的运动", "热力学问题"],
      "common_mistakes": ["恰当条件验证错误", "求势函数时换元错误"],
      "exercise_types": ["验证恰当性并求解", "利用积分因子化为恰当方程"],
      "latex_templates": [
        "Mdx+Ndy=0,\\ \\frac{\\partial M}{\\partial y}=\\frac{\\partial N}{\\partial x}"
      ]
    },
    {
      "id": "integrating_factor",
      "name": "积分因子法",
      "description": "将非恰当方程Pdx+Qdy=0乘以积分因子μ(x,y)后化为恰当方程求解",
      "formulas": [
        "\\mu Pdx+\\mu Qdy=0",
        "\\frac{\\partial(\\mu P)}{\\partial y}=\\frac{\\partial(\\mu Q)}{\\partial x}",
        "\\mu(x)=e^{\\int\\frac{P_y-Q_x}{Q}dx}"
      ],
      "difficulty": "hard",
      "prerequisites": ["exact_ode", "partial_derivatives"],
      "applications": ["非保守力场修正", "工程热力学"],
      "common_mistakes": ["积分因子类型判断错误（只与x或y有关）", "偏导数计算错误"],
      "exercise_types": ["求仅与x有关的积分因子", "求仅与y有关的积分因子", "特殊形式积分因子"],
      "latex_templates": [
        "\\mu=e^{\\int\\frac{M_y-N_x}{N}dx},\\ \\mu=e^{\\int\\frac{N_x-M_y}{M}dy}"
      ]
    },
    {
      "id": "higher_order_linear_ode",
      "name": "高阶线性微分方程",
