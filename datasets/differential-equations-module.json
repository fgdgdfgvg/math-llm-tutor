      "common_mistakes": ["特征方程列写错误", "复根情况三角函数形式遗忘", "重根时缺少x因子"],
      "exercise_types": ["二阶齐次方程求解", "高阶齐次方程求解", "含参数特征根讨论"],
      "latex_templates": [
        "y''+py'+qy=0,\\ r_{1,2}=\\frac{-p\\pm\\sqrt{p^2-4q}}{2}"
      ]
    },
    {
