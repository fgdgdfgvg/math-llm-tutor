    {
      "id": "separable_ode",
      "name": "可分离变量方程",
      "description": "可写成g(y)dy=f(x)dx形式的一阶微分方程，通过两边积分求解",
      "formulas": ["\\frac{dy}{dx}=f(x)g(y)", "\\int\\frac{dy}{g(y)}=\\int f(x)dx+C"],
      "difficulty": "easy",
      "prerequisites": ["integral_methods", "de_basic_concepts"],
      "applications": ["放射性衰变", "牛顿冷却定律", "人口增长模型"],
      "common_mistakes": ["分离变量时遗漏除数为零的情况（奇异解）", "积分常数C遗漏"],
      "exercise_types": ["直接可分离变量的方程求解", "需适当变形后方可分离的方程", "含奇解（包络）的方程"],
      "latex_templates": [
        "\\frac{dy}{dx}=f(x)g(y)\\Rightarrow\\int\\frac{dy}{g(y)}=\\int f(x)dx"
      ]
    },
    {
      "id": "homogeneous_ode",
      "name": "齐次方程",
      "description": "可化为dy/dx=φ(y/x)形式的一阶方程，通过u=y/x替换化为可分离变量方程",
      "formulas": ["\\frac{dy}{dx}=\\varphi\\left(\\frac{y}{x}\\right)", "y=ux,\\ \\frac{dy}{dx}=u+x\\frac{du}{dx}"],
      "difficulty": "medium",
