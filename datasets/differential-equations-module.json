      "exercise_types": ["标准齐次方程求解", "可化为齐次方程的方程"],
      "latex_templates": [
        "\\frac{dy}{dx}=f\\left(\\frac{y}{x}\\right),\\ u=\\frac{y}{x}\\Rightarrow x\\frac{du}{dx}=f(u)-u"
      ]
    },
    {
      "id": "first_order_linear_ode",
      "name": "一阶线性微分方程",
      "description": "形如y'+P(x)y=Q(x)的一阶方程，使用积分因子法或常数变易法求解",
      "formulas": [
        "y'+P(x)y=Q(x)",
        "\\mu(x)=e^{\\int P(x)dx}",
        "y=e^{-\\int Pdx}\\left(\\int Qe^{\\int Pdx}dx+C\\right)"
      ],
      "difficulty": "medium",
      "prerequisites": ["integral_methods", "separable_ode"],
