      "difficulty": "medium",
      "prerequisites": ["partial_derivatives", "vector_basics"],
      "applications": ["最速上升/下降方向", "地形分析", "热流方向"],
      "common_mistakes": ["方向向量的方向余弦计算错误", "与偏导数混淆（偏导数是特殊的方向导数）"],
      "exercise_types": ["求指定方向导数", "最大方向导数（梯度模）", "方向导数为零的方向"],
      "latex_templates": [
        "\\frac{\\partial f}{\\partial\\mathbf{l}}=\\nabla f\\cdot\\mathbf{u}"
      ]
    },
    {
      "id": "gradient",
      "name": "梯度",
      "description": "梯度向量的定义、性质（最大方向导数方向）、几何意义（等值线的法向量）",
      "formulas": [
        "\\nabla f=\\left(\\frac{\\partial f}{\\partial x},\\frac{\\partial f}{\\partial y}\\right)",
        "\\nabla f=\\frac{\\partial f}{\\partial x}\\mathbf{i}+\\frac{\\partial f}{\\partial y}\\mathbf{j}+\\frac{\\partial f}{\\partial z}\\mathbf{k}",
        "\\|\\nabla f\\|=\\max\\frac{\\partial f}{\\partial\\mathbf{l}}"
