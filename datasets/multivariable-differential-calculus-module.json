      ]
    },
    {
      "id": "multivariable_extrema",
      "name": "多元函数的极值",
      "description": "无条件极值的必要条件（梯度为零）和充分条件（海森矩阵的正定性），二元函数的AC-B²判别法",
      "formulas": [
        "\\nabla f=0\\text{（必要条件）}",
        "A=f_{xx},\\ B=f_{xy},\\ C=f_{yy}"
