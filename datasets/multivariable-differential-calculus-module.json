      "difficulty": "medium",
      "prerequisites": ["partial_derivatives", "single_variable_chain_rule"],
      "applications": ["变量替换", "物理中的坐标变换", "最优化中的敏感度"],
      "common_mistakes": ["变量关系图理解错误", "中间变量和自变量混淆", "漏项（忘记所有路径求和）"],
      "exercise_types": ["全导数问题", "复合函数偏导数", "抽象函数求导"],
      "latex_templates": [
        "\\frac{\\partial z}{\\partial x}=\\frac{\\partial f}{\\partial u}\\frac{\\partial u}{\\partial x}+\\frac{\\partial f}{\\partial v}\\frac{\\partial v}{\\partial x}"
      ]
    },
    {
      "id": "implicit_function_theorem",
      "name": "隐函数定理",
      "description": "隐函数的存在性条件（隐函数定理）及隐函数的求导方法（公式法和直接法）",
      "formulas": [
        "F(x,y)=0,\\ F_y\\neq0\\Rightarrow\\frac{dy}{dx}=-\\frac{F_x}{F_y}",
        "F(x,y,z)=0,\\ F_z\\neq0\\Rightarrow\\frac{\\partial z}{\\partial x}=-\\frac{F_x}{F_z}"
      ],
      "difficulty": "medium",
      "prerequisites": ["partial_derivatives", "total_differential"],
      "applications": ["等值面分析", "约束方程的导数", "热力学方程"],
      "common_mistakes": ["负号遗漏", "分子分母颠倒", "不验证F_y≠0条件"],
      "exercise_types": ["一个方程一个隐函数", "一个方程两个隐函数", "方程组隐函数"],
      "latex_templates": [
        "\\frac{\\partial z}{\\partial x}=-\\frac{F_x}{F_z},\\ \\frac{\\partial z}{\\partial y}=-\\frac{F_y}{F_z}"
      ]
    },
    {
      "id": "directional_derivative",
      "name": "方向导数",
      "description": "函数沿给定方向的变化率定义与计算，方向导数与偏导数的关系",
      "formulas": [
        "\\frac{\\partial f}{\\partial\\mathbf{l}}=\\lim_{t\\to0^+}\\frac{f(x_0+t\\cos\\alpha,y_0+t\\cos\\beta)-f(x_0,y_0)}{t}",
        "\\frac{\\partial f}{\\partial\\mathbf{l}}=f_x\\cos\\alpha+f_y\\cos\\beta"
