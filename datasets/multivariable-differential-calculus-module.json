      "difficulty": "medium",
      "prerequisites": ["multivariable_limit"],
      "applications": ["曲面光滑性分析", "插值方法基础"],
      "common_mistakes": ["混淆点连续和区域连续", "不验证函数是否为初等函数"],
      "exercise_types": ["判断连续性", "找间断点类型", "讨论含参函数的连续性"],
      "latex_templates": [
        "f(x,y)\\in C(D)"
      ]
    },
    {
      "id": "partial_derivatives",
      "name": "偏导数",
      "description": "多元函数对某一自变量的偏导数定义、几何意义和计算方法，高阶偏导数",
      "formulas": [
        "\\frac{\\partial f}{\\partial x}=\\lim_{\\Delta x\\to0}\\frac{f(x+\\Delta x,y)-f(x,y)}{\\Delta x}",
        "f_x(x_0,y_0)",
        "\\frac{\\partial^2 f}{\\partial x\\partial y}"
      ],
      "difficulty": "medium",
      "prerequisites": ["multivariable_limit", "single_variable_derivatives"],
      "applications": ["边际分析（经济学）", "灵敏度分析", "误差传递"],
      "common_mistakes": ["偏导数记号混淆（f_x, ∂f/∂x）", "高阶混合偏导数顺序不验证可交换性"],
      "exercise_types": ["求一阶偏导数", "求高阶偏导数", "偏导数几何意义"],
      "latex_templates": [
        "\\frac{\\partial f}{\\partial x}=\\lim_{\\Delta x\\to0}\\frac{f(x+\\Delta x,y)-f(x,y)}{\\Delta x}"
      ]
    },
    {
      "id": "total_differential",
      "name": "全微分",
      "description": "全微分的定义、可微的充分条件、全微分的四则运算和链式法则",
      "formulas": [
        "dz=\\frac{\\partial z}{\\partial x}dx+\\frac{\\partial z}{\\partial y}dy",
        "\\Delta z=f_x\\Delta x+f_y\\Delta y+o(\\rho)",
        "dz=f_x dx+f_y dy"
      ],
      "difficulty": "medium",
      "prerequisites": ["partial_derivatives", "single_variable_differentials"],
      "applications": ["近似计算", "误差估计", "灵敏度分析"],
      "common_mistakes": ["混淆'可导'和'可微'概念", "不验证偏导数连续的可微性充分条件"],
      "exercise_types": ["求全微分", "全微分近似计算", "判断函数可微性"],
      "latex_templates": [
        "du=f_x dx+f_y dy+f_z dz"
      ]
    },
    {
      "id": "chain_rule_multivariable",
      "name": "多元复合函数求导（链式法则）",
      "description": "多元复合函数求导的链式法则，包括全导数和偏导数情况，变量关系图法",
      "formulas": [
        "\\frac{dz}{dt}=\\frac{\\partial z}{\\partial x}\\frac{dx}{dt}+\\frac{\\partial z}{\\partial y}\\frac{dy}{dt}",
        "\\frac{\\partial z}{\\partial u}=\\frac{\\partial z}{\\partial x}\\frac{\\partial x}{\\partial u}+\\frac{\\partial z}{\\partial y}\\frac{\\partial y}{\\partial u}"
