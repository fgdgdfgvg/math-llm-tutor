      "applications": ["最优化中的梯度下降法", "图像边缘检测", "机器学习参数更新"],
      "common_mistakes": ["梯度和方向导数公式混淆", "忘记梯度方向是函数增长最快的方向"],
      "exercise_types": ["求梯度向量", "求最大方向导数", "求等值线的法线"],
      "latex_templates": [
        "\\nabla f(x_0,y_0)=(f_x(x_0,y_0),f_y(x_0,y_0))"
      ]
    },
    {
      "id": "tangent_plane_normal_line",
      "name": "空间曲线的切线与法平面、曲面的切平面与法线",
      "description": "利用偏导数和梯度求曲线和曲面的切向和法向量",
      "formulas": [
