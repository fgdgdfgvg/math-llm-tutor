      ]
    },
    {
      "id": "multivariable_limit",
      "name": "多元函数极限",
      "description": "P→P₀时f(P)→A的定义，二重极限的存在性和计算，累次极限与二重极限的关系",
      "formulas": [
        "\\lim_{(x,y)\\to(x_0,y_0)}f(x,y)=A",
        "\\forall\\varepsilon>0,\\exists\\delta>0:\\ 0<\\rho<\\delta\\Rightarrow|f-A|<\\varepsilon"
      ],
      "difficulty": "medium",
      "prerequisites": ["multivariable_function_basics", "single_variable_limit"],
      "applications": ["曲面奇点分析", "函数连续性判断"],
      "common_mistakes": ["认为沿任何路径极限都相等才能确定极限", "将二重极限和二次极限（累次极限）混淆"],
      "exercise_types": ["用定义证明极限", "判断极限不存在", "计算二重极限"],
      "latex_templates": [
        "\\lim_{(x,y)\\to(0,0)}f(x,y)=L",
        "\\rho=\\sqrt{(x-x_0)^2+(y-y_0)^2}"
      ]
    },
    {
      "id": "multivariable_continuity",
      "name": "多元函数连续性",
      "description": "多元函数在点处和区域上的连续性，连续函数的性质（有界性、最值定理、介值定理），初等函数的连续性",
      "formulas": [
        "\\lim_{(x,y)\\to(x_0,y_0)}f(x,y)=f(x_0,y_0)",
        "f\\in C(D)\\Rightarrow f\\text{在}D\\text{上有界且取得最大值和最小值}"
