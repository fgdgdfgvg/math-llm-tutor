      ]
    },
    {
      "id": "differentials_approximation",
      "name": "微分的近似计算",
      "description": "利用微分进行函数值的近似计算",
      "formulas": [
        "f(x_0+\\Delta x)\\approx f(x_0)+f'(x_0)\\Delta x",
