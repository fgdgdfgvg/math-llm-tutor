{
  "module_name": "定积分应用",
  "module_id": "definite_integral_applications",
  "description": "涵盖定积分在几何（面积、体积、弧长、旋转体表面积）、物理（功、水压力、质心、转动惯量）、经济及工程技术中的各类应用",
  "knowledge_points": [
    {
      "id": "area_between_curves",
      "name": "平面图形的面积",
      "description": "利用定积分计算由两条或多条曲线围成的平面区域面积，包括直角坐标和参数方程形式",
      "formulas": [
        "A=\\int_a^b[f(x)-g(x)]dx",
        "A=\\int_c^d[\\varphi(y)-\\psi(y)]dy",
        "A=\\frac{1}{2}\\int_{\\alpha}^{\\beta}[r_2^2(\\theta)-r_1^2(\\theta)]d\\theta"
      ],
      "difficulty": "easy",
      "prerequisites": ["definite_integral_computation", "curve_sketching"],
      "applications": ["土地面积测量", "截面面积计算", "概率密度下的面积"],
      "common_mistakes": ["积分限确定错误", "上下曲线判断颠倒", "忽略曲线相交点"],
      "exercise_types": ["直角坐标下面积", "参数方程下面积", "极坐标下面积"],
      "latex_templates": [
        "A=\\int_a^b|f(x)-g(x)|dx"
      ]
    },
    {
      "id": "volume_of_solid",
      "name": "立体体积",
      "description": "利用截面法（切片法）和柱壳法计算旋转体及一般立体的体积",
      "formulas": [
        "V=\\int_a^b A(x)dx",
        "V=\\pi\\int_a^b[f(x)]^2dx",
        "V=2\\pi\\int_a^b xf(x)dx",
        "V=\\pi\\int_a^b([f(x)]^2-[g(x)]^2)dx"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "area_between_curves", "solid_geometry"],
      "applications": ["容器容积计算", "土木工程土方量", "3D打印体积预估"],
      "common_mistakes": ["旋转轴选择错误导致公式用错", "柱壳法中半径表达错误", "忽略空心部分的体积"],
      "exercise_types": ["绕x轴旋转体体积", "绕y轴旋转体体积", "截面法求体积", "柱壳法求体积"],
      "latex_templates": [
        "V=\\pi\\int_a^b y^2dx,\\ V=2\\pi\\int_a^b xydx"
      ]
    },
    {
      "id": "arc_length",
      "name": "平面曲线弧长",
      "description": "利用弧微分ds计算平面曲线的长度，支持直角坐标、参数方程和极坐标形式",
      "formulas": [
        "L=\\int_a^b\\sqrt{1+[f'(x)]^2}dx",
        "L=\\int_{\\alpha}^{\\beta}\\sqrt{[x'(t)]^2+[y'(t)]^2}dt",
        "L=\\int_{\\alpha}^{\\beta}\\sqrt{[r(\\theta)]^2+[r'(\\theta)]^2}d\\theta"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "derivative_rules", "parametric_equations"],
      "applications": ["道路长度测算", "电缆长度估算", "悬链线问题"],
      "common_mistakes": ["弧微分公式记错", "参数方程下忘记乘dt", "极坐标的弧微分混淆"],
      "exercise_types": ["函数图像弧长", "参数曲线弧长", "极坐标曲线弧长"],
      "latex_templates": [
        "ds=\\sqrt{(dx)^2+(dy)^2}=\\sqrt{1+(y')^2}dx"
      ]
    },
    {
      "id": "surface_area",
      "name": "旋转体表面积",
      "description": "将平面曲线绕坐标轴旋转所得曲面的表面积计算",
      "formulas": [
        "S=2\\pi\\int_a^b f(x)\\sqrt{1+[f'(x)]^2}dx",
        "S=2\\pi\\int_a^b x\\sqrt{1+[f'(x)]^2}dx",
        "S=2\\pi\\int_{\\alpha}^{\\beta} y(t)\\sqrt{[x'(t)]^2+[y'(t)]^2}dt"
      ],
      "difficulty": "medium",
      "prerequisites": ["arc_length", "volume_of_solid"],
      "applications": ["容器表面积计算", "航天器隔热层面积", "建筑曲面设计"],
      "common_mistakes": ["半径表达错误（绕不同轴旋转半径不同）", "弧微分与被积函数混淆"],
      "exercise_types": ["绕x轴旋转的表面积", "绕y轴旋转的表面积", "参数形式表面积"],
      "latex_templates": [
        "S=2\\pi\\int_a^b y\\sqrt{1+(y')^2}dx"
      ]
    },
    {
      "id": "work_by_variable_force",
      "name": "变力做功",
      "description": "利用定积分计算变力沿曲线路径所做的功",
      "formulas": [
        "W=\\int_a^b F(x)dx",
        "W=\\int_a^b kxdx=\\frac{1}{2}kx^2",
        "W=\\int_a^b\\rho gAxdx"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "physics_mechanics"],
      "applications": ["弹簧做功", "抽水做功", "火箭推进做功", "气体膨胀做功"],
      "common_mistakes": ["力的方向与位移方向关系判断错误", "单位制不统一", "积分变量选择错误"],
      "exercise_types": ["弹性力做功", "重力做功", "浮力做功"],
      "latex_templates": [
        "W=\\int_a^b F(x)dx,\\ W=\\int_C\\mathbf{F}\\cdot d\\mathbf{r}"
      ]
    },
    {
      "id": "hydrostatic_pressure",
      "name": "液体压力",
      "description": "用定积分计算液体对垂直或倾斜壁面的静水总压力",
      "formulas": [
        "P=\\rho g\\int_a^b x w(x)dx",
        "F=\\int_a^b \\rho g h(x) w(x)dx"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "physics_hydrostatics"],
      "applications": ["水坝设计", "潜艇舱壁强度", "储液罐壁厚计算"],
      "common_mistakes": ["深度表达错误（参考面选择不当）", "宽度函数w(x)确定错误"],
      "exercise_types": ["矩形平板压力", "三角形平板压力", "梯形截面压力"],
      "latex_templates": [
        "F=\\int_a^b\\rho g\\cdot(\\text{depth})\\cdot(\\text{width})dx"
      ]
    },
    {
      "id": "center_of_mass",
      "name": "质心与形心",
      "description": "利用定积分计算平面薄片和曲线的质心（质量中心）坐标",
      "formulas": [
        "\\bar{x}=\\frac{\\int_a^b x\\rho(x)f(x)dx}{\\int_a^b\\rho(x)f(x)dx}",
        "\\bar{x}=\\frac{\\int_a^b x[f(x)-g(x)]dx}{\\int_a^b[f(x)-g(x)]dx}",
        "M_x=\\rho\\int_a^b\\frac{1}{2}[f(x)]^2dx"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "area_between_curves"],
      "applications": ["结构平衡设计", "车辆重心计算", "航空器配平"],
      "common_mistakes": ["质心和形心概念混淆（均匀密度时相同）", "对x轴和对y轴的矩公式写反"],
      "exercise_types": ["均匀密度形心", "变密度质心", "对称性简化计算"],
      "latex_templates": [
        "\\bar{x}=\\frac{M_y}{M},\\ \\bar{y}=\\frac{M_x}{M}"
      ]
    },
    {
      "id": "moment_of_inertia",
      "name": "转动惯量",
      "description": "利用定积分计算平面图形和旋转体对坐标轴的转动惯量",
      "formulas": [
        "I_x=\\int y^2dm",
        "I_x=\\rho\\int_a^b\\frac{1}{3}[f(x)]^3dx",
        "I_y=\\rho\\int_a^b x^2f(x)dx",
        "I=\\int r^2dm"
      ],
      "difficulty": "hard",
      "prerequisites": ["center_of_mass", "volume_of_solid"],
      "applications": ["飞轮设计", "机械旋转部件", "结构抗震分析"],
      "common_mistakes": ["平行轴定理使用条件忽略", "微元dm的表达式错误"],
      "exercise_types": ["平面图形的转动惯量", "旋转体的转动惯量", "平行轴定理应用"],
      "latex_templates": [
        "I=\\int r^2dm,\\ I=I_c+md^2"
      ]
    },
    {
      "id": "average_value",
      "name": "函数的平均值",
      "description": "利用积分中值定理计算函数在区间上的平均值和均方根值",
      "formulas": [
        "f_{avg}=\\frac{1}{b-a}\\int_a^b f(x)dx",
        "f_{rms}=\\sqrt{\\frac{1}{b-a}\\int_a^b[f(x)]^2dx}",
        "\\int_a^b f(x)dx=f(\\xi)(b-a)"
      ],
      "difficulty": "easy",
      "prerequisites": ["definite_integral_computation", "mean_value_theorem_integrals"],
      "applications": ["平均速度", "有效值计算", "统计平均值"],
      "common_mistakes": ["忘记除以区间长度", "均方根和平均值混淆"],
      "exercise_types": ["求函数平均值", "交流电有效值", "温度平均值"],
      "latex_templates": [
        "\\bar{f}=\\frac{1}{b-a}\\int_a^b f(x)dx"
      ]
    },
    {
      "id": "probability_integrals",
      "name": "概率密度与积分",
      "description": "利用定积分计算连续型随机变量在给定区间内的概率",
      "formulas": [
        "P(a\\leq X\\leq b)=\\int_a^b f(x)dx",
        "\\int_{-\\infty}^{\\infty}f(x)dx=1",
        "E(X)=\\int_{-\\infty}^{\\infty}xf(x)dx"
      ],
      "difficulty": "medium",
      "prerequisites": ["definite_integral_computation", "probability_basics"],
      "applications": ["正态分布概率", "可靠性分析", "质量控制"],
      "common_mistakes": ["概率密度函数归一化条件忘记验证", "积分限写错"],
      "exercise_types": ["求区间概率", "求期望值", "正态分布表查值"],
      "latex_templates": [
        "P(a<X<b)=\\int_a^b f_X(x)dx"
      ]
    },
    {
      "id": "economic_applications",
      "name": "经济应用",
      "description": "定积分在经济学中的应用：消费者剩余、生产者剩余、洛伦兹曲线、基尼系数",
      "formulas": [
        "CS=\\int_0^{Q_0}[D(Q)-P_0]dQ",
        "PS=\\int_0^{Q_0}[P_0-S(Q)]dQ",
        "G=1-2\\int_0^1 L(x)dx"
      ],
      "difficulty": "medium",
      "prerequisites": ["area_between_curves", "economics_basics"],
      "applications": ["社会福利分析", "税收政策评估", "收入不平等度量"],
      "common_mistakes": ["消费者剩余和生产者剩余的积分区域混淆", "基尼系数中面积计算错误"],
      "exercise_types": ["消费者剩余计算", "生产者剩余计算", "基尼系数推导"],
      "latex_templates": [
        "\\text{CS}=\\int_0^{q^*}[D(q)-p^*]dq"
      ]
    },
    {
      "id": "liquid_work_pumping",
      "name": "抽水做功与液体问题",
      "description": "综合应用：将液体从容器中抽出所做的功，多层液体分层问题",
      "formulas": [
        "W=\\int_a^b\\rho gA(y)h(y)dy",
        "dW=(\\rho dV)gh"
      ],
      "difficulty": "hard",
      "prerequisites": ["work_by_variable_force", "hydrostatic_pressure"],
      "applications": ["水泵选型计算", "给排水工程", "石油开采"],
      "common_mistakes": ["分层液体的密度不同未区分", "液面变化导致高度变化需动态考虑"],
      "exercise_types": ["锥形容器抽水", "球形容器抽水", "多层液体抽水"],
      "latex_templates": [
        "dW=\\rho g\\cdot(\\text{体积微元})\\cdot(\\text{提升高度})"
      ]
    },
    {
      "id": "pappus_theorem",
      "name": "帕普斯定理",
      "description": "旋转体的体积等于旋转图形面积乘以形心所走路径长度；旋转体表面积等于旋转曲线长度乘以形心路径长度",
      "formulas": [
        "V=A\\cdot(2\\pi\\bar{y})",
        "S=L\\cdot(2\\pi\\bar{y})"
      ],
      "difficulty": "medium",
      "prerequisites": ["center_of_mass", "volume_of_solid", "surface_area"],
      "applications": ["快速计算对称旋转体", "圆环体和轮胎形状的体积"],
      "common_mistakes": ["形心位置计算错误", "未区分图形形心和曲线形心"],
      "exercise_types": ["应用帕普斯定理求体积", "应用帕普斯定理求表面积", "在已知体积时反求形心"],
      "latex_templates": [
        "V=2\\pi\\bar{y}A,\\ S=2\\pi\\bar{y}L"
      ]
    },
    {
      "id": "improper_integral_apps",
      "name": "反常积分的应用",
      "description": "无穷区间和瑕积分在实际问题中的应用，包括收敛性判断",
      "formulas": [
        "\\int_a^{\\infty}f(x)dx=\\lim_{b\\to\\infty}\\int_a^b f(x)dx",
        "\\int_{-\\infty}^{\\infty}e^{-x^2}dx=\\sqrt{\\pi}"
      ],
      "difficulty": "hard",
      "prerequisites": ["improper_integrals", "limit_computation"],
      "applications": ["概率论中的正态分布", "物理中的势能计算", "信号的能量谱"],
      "common_mistakes": ["不验证收敛性直接计算", "瑕积分处理遗漏瑕点"],
      "exercise_types": ["概率积分", "物理中的反常积分", "收敛性判断应用"],
      "latex_templates": [
        "\\Gamma(n)=\\int_0^{\\infty}x^{n-1}e^{-x}dx"
      ]
    },
    {
      "id": "definite_integral_modeling",
      "name": "定积分建模综合",
      "description": "综合运用定积分思想建立解决实际问题的数学模型，培养分割-近似-求和-取极限的思维",
      "formulas": ["微元法: 分割→近似→求和→取极限"],
      "difficulty": "hard",
      "prerequisites": ["所有前述知识点"],
      "applications": ["工程设计优化", "资源分配问题", "流体动力学", "金融工程"],
      "common_mistakes": ["微元选取不当导致积分复杂化", "忽略问题的实际约束条件"],
      "exercise_types": ["多学科交叉建模", "工程案例综合分析"],
      "latex_templates": []
    }
  ],
