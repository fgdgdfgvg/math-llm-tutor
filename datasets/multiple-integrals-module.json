      ]
    },
    {
      "id": "multiple_integral_symmetry",
      "name": "重积分的对称性与奇偶性",
      "description": "利用积分区域关于坐标面（轴）的对称性和被积函数的奇偶性简化重积分计算",
      "formulas": [
