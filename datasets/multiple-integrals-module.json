        "\\Omega\\text{关于}xOy\\text{面对称}，类似结论"
      ],
      "difficulty": "medium",
      "prerequisites": ["double_integral_concept", "triple_integral_concept"],
      "applications": ["快速估算积分为零的情况", "简化复杂区域上的积分"],
      "common_mistakes": ["对称性与奇偶性的条件判断错误（对称需关于坐标轴/面/原点）", "被积函数奇偶性判断错误", "奇×偶=奇的结论应用"],
      "exercise_types": ["利用对称性判断积分值", "利用对称性简化计算", "判断积分是否为零"],
      "latex_templates": [
        "\\iint_D xy\\,\\mathrm{d}\\sigma=0\\ (D\\text{关于}x\\text{轴对称且}f(x,-y)=-f(x,y))"
