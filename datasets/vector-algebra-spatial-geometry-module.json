      ],
      "difficulty": "hard",
      "prerequisites": ["plane_equations", "space_line_equations", "cross_product", "scalar_triple_product"],
      "applications": ["三维测量", "路径规划中的避障距离", "建筑结构分析"],
      "common_mistakes": ["线面角用cos而不是sin", "异面直线距离公式行列式符号", "距离与角度的计算公式混淆"],
      "exercise_types": ["求点到直线的距离", "求两异面直线的距离", "综合计算距离与角度"],
