    {
      "id": "vector_basic_concepts",
      "name": "向量的基本概念与线性运算",
      "description": "向量的定义、模、方向角与方向余弦，向量的加法和减法（三角形法则、平行四边形法则），数与向量的乘法",
      "formulas": [
        "\\vec{a}=(a_x,a_y,a_z)",
        "|\\vec{a}|=\\sqrt{a_x^2+a_y^2+a_z^2}",
        "\\cos\\alpha=\\frac{a_x}{|\\vec{a}|},\\ \\cos^2\\alpha+\\cos^2\\beta+\\cos^2\\gamma=1"
