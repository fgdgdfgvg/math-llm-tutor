{
  "module_name": "向量代数与空间解析几何",
  "module_id": "vector_algebra_spatial_geometry",
  "description": "涵盖空间直角坐标系、向量及其线性运算、数量积与向量积、平面与空间直线方程、空间曲面与空间曲线、二次曲面分类及其标准方程",
  "knowledge_points": [
    {
      "id": "spatial_coordinate_system",
      "name": "空间直角坐标系",
      "description": "空间直角坐标系的建立，点的坐标表示，两点间距离公式，空间中的象限与卦限划分",
      "formulas": [
        "d=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2+(z_2-z_1)^2}",
