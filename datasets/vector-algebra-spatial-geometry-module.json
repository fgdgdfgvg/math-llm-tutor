      "difficulty": "easy",
      "prerequisites": ["spatial_coordinate_system", "trigonometry_basics"],
      "applications": ["力学中的力矢量", "速度与加速度", "电磁学中的场矢量"],
      "common_mistakes": ["方向余弦符号错误", "向量模的计算遗漏分量"],
      "exercise_types": ["求向量的模与方向余弦", "向量的线性运算", "求单位向量"],
      "latex_templates": [
        "\\vec{a}=(a_x,a_y,a_z),\\ |\\vec{a}|=\\sqrt{a_x^2+a_y^2+a_z^2}"
      ]
    },
    {
      "id": "dot_product",
      "name": "向量的数量积（点积）",
      "description": "数量积的定义、坐标表示、运算性质及应用：判定垂直、求夹角、求投影",
      "formulas": [
        "\\vec{a}\\cdot\\vec{b}=|\\vec{a}||\\vec{b}|\\cos\\theta",
        "\\vec{a}\\cdot\\vec{b}=a_x b_x+a_y b_y+a_z b_z",
        "\\cos\\theta=\\frac{\\vec{a}\\cdot\\vec{b}}{|\\vec{a}||\\vec{b}|}",
        "\\text{Prj}_{\\vec{b}}\\vec{a}=\\frac{\\vec{a}\\cdot\\vec{b}}{|\\vec{b}|}"
      ],
      "difficulty": "medium",
      "prerequisites": ["vector_basic_concepts", "trigonometry_basics"],
      "applications": ["功的计算（W=F·s）", "判断向量垂直", "方向导数基础"],
      "common_mistakes": ["点积与叉积混淆", "投影长度符号错误", "坐标计算时遗漏分量"],
      "exercise_types": ["计算数量积", "求两向量夹角", "求向量在另一向量上的投影", "证明垂直关系"],
      "latex_templates": [
        "\\vec{a}\\cdot\\vec{b}=|\\vec{a}||\\vec{b}|\\cos\\theta",
        "\\vec{a}\\perp\\vec{b}\\iff\\vec{a}\\cdot\\vec{b}=0"
      ]
    },
    {
      "id": "cross_product",
      "name": "向量的向量积（叉积）",
