      "common_mistakes": ["投影曲线方程中遗漏消去参数的条件", "参数方程与一般方程之间的转换错误"],
      "exercise_types": ["求空间曲线的参数方程", "求曲线在坐标面上的投影", "判断曲线类型"],
      "latex_templates": [
        "\\begin{cases}x^2+y^2+z^2=R^2\\\\z=h\\end{cases}\\ (\\text{圆})"
      ]
    },
    {
      "id": "quadric_surfaces",
      "name": "二次曲面",
      "description": "椭球面、单叶双曲面、双叶双曲面、椭圆抛物面、双曲抛物面（马鞍面）、二次锥面的标准方程与图形特征，截痕法判断二次曲面形状",
      "formulas": [
        "\\frac{x^2}{a^2}+\\frac{y^2}{b^2}+\\frac{z^2}{c^2}=1\\ (\\text{椭球面})",
        "\\frac{x^2}{a^2}+\\frac{y^2}{b^2}-\\frac{z^2}{c^2}=1\\ (\\text{单叶双曲面})",
        "\\frac{x^2}{a^2}-\\frac{y^2}{b^2}-\\frac{z^2}{c^2}=1\\ (\\text{双叶双曲面})",
        "z=\\frac{x^2}{a^2}+\\frac{y^2}{b^2}\\ (\\text{椭圆抛物面})",
        "z=\\frac{x^2}{a^2}-\\frac{y^2}{b^2}\\ (\\text{马鞍面})"
      ],
      "difficulty": "hard",
      "prerequisites": ["surfaces", "conic_sections"],
      "applications": ["建筑设计（双曲面冷却塔）", "天线反射面设计", "光学镜面设计"],
      "common_mistakes": ["单叶与双叶双曲面符号混淆", "马鞍面方向判断错误", "截痕法不一定适用于所有二次曲面"],
      "exercise_types": ["根据方程判断二次曲面类型", "用截痕法分析曲面形状", "求旋转抛物面的焦点"],
      "latex_templates": [
        "\\frac{x^2}{a^2}+\\frac{y^2}{b^2}+\\frac{z^2}{c^2}=1",
        "z=\\frac{x^2}{2p}+\\frac{y^2}{2q}"
      ]
    },
    {
      "id": "spatial_transformations",
      "name": "空间坐标变换",
      "description": "坐标轴的平移变换和旋转变换，一般二次方程通过坐标变换化为标准型的基本思想",
      "formulas": [
