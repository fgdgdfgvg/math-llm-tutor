    {
      "id": "spatial_distance_angle",
      "name": "空间距离与角度综合",
      "description": "空间中的距离问题（点到直线、点到平面、两异面直线间距离）与角度问题（线线角、线面角、面面角）的综合计算",
      "formulas": [
