        "\\begin{pmatrix} x' \\\\ y' \\\\ z' \\end{pmatrix}=R\\begin{pmatrix} x \\\\ y \\\\ z \\end{pmatrix}"
      ],
      "difficulty": "hard",
      "prerequisites": ["quadric_surfaces", "linear_algebra_basics"],
      "applications": ["刚体运动学", "坐标系转换", "机器人坐标变换"],
      "common_mistakes": ["旋转矩阵的逆矩阵公式错误", "平移和旋转顺序不正确"],
      "exercise_types": ["平移变换化简曲面方程", "求旋转变换矩阵", "判断变换后曲面的类型"],
      "latex_templates": [
