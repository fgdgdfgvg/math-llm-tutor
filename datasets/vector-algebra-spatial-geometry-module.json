      "formulas": [
        "|\\vec{a}\\times\\vec{b}|=|\\vec{a}||\\vec{b}|\\sin\\theta",
        "\\vec{a}\\times\\vec{b}=\\begin{vmatrix} \\vec{i} & \\vec{j} & \\vec{k} \\\\ a_x & a_y & a_z \\\\ b_x & b_y & b_z \\end{vmatrix}",
        "S_{\\text{平行四边形}}=|\\vec{a}\\times\\vec{b}|"
      ],
      "difficulty": "medium",
      "prerequisites": ["dot_product", "determinants"],
      "applications": ["力矩的计算（M=r×F）", "平行四边形面积", "判定向量平行"],
      "common_mistakes": ["叉积反交换律（a×b=-b×a）忽略符号", "行列式计算符号错误", "方向判断错误（右手定则）"],
      "exercise_types": ["计算向量积", "求平行四边形的面积", "求同时垂直于两个向量的向量", "证明平行关系"],
      "latex_templates": [
        "\\vec{a}\\times\\vec{b}=\\begin{vmatrix}\\vec{i}&\\vec{j}&\\vec{k}\\\\a_x&a_y&a_z\\\\b_x&b_y&b_z\\end{vmatrix}",
        "\\vec{a}\\parallel\\vec{b}\\iff\\vec{a}\\times\\vec{b}=\\vec{0}"
      ]
    },
    {
      "id": "scalar_triple_product",
      "name": "向量的混合积",
      "description": "三个向量的混合积定义、坐标表示、几何意义（平行六面体体积）及应用：判定共面",
      "formulas": [
        "[\\vec{a}\\ \\vec{b}\\ \\vec{c}]=(\\vec{a}\\times\\vec{b})\\cdot\\vec{c}=\\begin{vmatrix} a_x & a_y & a_z \\\\ b_x & b_y & b_z \\\\ c_x & c_y & c_z \\end{vmatrix}",
        "V_{\\text{平行六面体}}=|[\\vec{a}\\ \\vec{b}\\ \\vec{c}]|"
      ],
      "difficulty": "medium",
      "prerequisites": ["dot_product", "cross_product", "determinants"],
      "applications": ["四面体体积", "判定三向量共面", "晶胞体积计算"],
      "common_mistakes": ["混合积的轮换性质记忆错误", "体积计算遗漏绝对值"],
      "exercise_types": ["计算混合积", "求四面体体积", "判断三向量是否共面"],
      "latex_templates": [
        "[\\vec{a}\\ \\vec{b}\\ \\vec{c}]=\\begin{vmatrix}a_x&a_y&a_z\\\\b_x&b_y&b_z\\\\c_x&c_y&c_z\\end{vmatrix}"
      ]
    },
    {
      "id": "plane_equations",
      "name": "平面方程",
      "description": "平面的点法式方程、一般方程、截距式方程，两平面的夹角，点到平面的距离",
      "formulas": [
        "A(x-x_0)+B(y-y_0)+C(z-z_0)=0",
        "Ax+By+Cz+D=0",
        "d=\\frac{|Ax_0+By_0+Cz_0+D|}{\\sqrt{A^2+B^2+C^2}}",
        "\\cos\\theta=\\frac{|A_1A_2+B_1B_2+C_1C_2|}{\\sqrt{A_1^2+B_1^2+C_1^2}\\sqrt{A_2^2+B_2^2+C_2^2}}"
      ],
      "difficulty": "medium",
      "prerequisites": ["dot_product", "vector_basic_concepts"],
      "applications": ["三维几何建模", "计算机图形学裁剪面", "地质层面表示"],
      "common_mistakes": ["法向量方向确定错误", "点到平面距离公式的绝对值遗漏", "一般方程系数与法向量的对应关系出错"],
      "exercise_types": ["已知点和法向量求平面方程", "求点到平面的距离", "求两平面的夹角", "求过三点的平面方程"],
      "latex_templates": [
        "\\vec{n}\\cdot(\\vec{r}-\\vec{r}_0)=0",
        "d=\\frac{|Ax_0+By_0+Cz_0+D|}{\\sqrt{A^2+B^2+C^2}}"
      ]
    },
    {
      "id": "space_line_equations",
      "name": "空间直线方程",
      "description": "空间直线的点向式方程（对称式）、参数方程、一般方程（两平面交线），两直线的夹角，直线与平面的夹角",
      "formulas": [
        "\\frac{x-x_0}{m}=\\frac{y-y_0}{n}=\\frac{z-z_0}{p}",
        "\\begin{cases} A_1x+B_1y+C_1z+D_1=0 \\\\ A_2x+B_2y+C_2z+D_2=0 \\end{cases}",
        "\\cos\\theta=\\frac{|m_1m_2+n_1n_2+p_1p_2|}{\\sqrt{m_1^2+n_1^2+p_1^2}\\sqrt{m_2^2+n_2^2+p_2^2}}"
      ],
      "difficulty": "medium",
      "prerequisites": ["plane_equations", "vector_basic_concepts"],
      "applications": ["光线追踪", "机械臂运动轨迹", "三维路径规划"],
      "common_mistakes": ["方向向量为零时分母为零的情况", "参数方程与对称式转换错误", "直线与平面夹角用\\sin而非\\cos"],
      "exercise_types": ["求空间直线方程", "求点到直线的距离", "判断两直线位置关系", "求直线与平面的交点"],
      "latex_templates": [
        "\\frac{x-x_0}{m}=\\frac{y-y_0}{n}=\\frac{z-z_0}{p}",
        "\\begin{cases}x=x_0+mt\\\\y=y_0+nt\\\\z=z_0+pt\\end{cases}"
      ]
    },
    {
      "id": "surfaces",
      "name": "空间曲面",
      "description": "曲面方程的一般形式和参数形式，旋转曲面（绕坐标轴旋转所得曲面），柱面（母线平行于坐标轴的柱面），常见曲面举例",
      "formulas": [
        "F(x,y,z)=0",
        "\\begin{cases} x=x(u,v) \\\\ y=y(u,v) \\\\ z=z(u,v) \\end{cases}"
