      "difficulty": "hard",
      "prerequisites": ["plane_equations", "multivariable_functions"],
      "applications": ["CAD造型", "建筑曲面设计", "物理中的等位面"],
      "common_mistakes": ["旋转曲面方程推导中消去参数的符号错误", "柱面方程少写一个变量（实际省略了该变量的范围）"],
      "exercise_types": ["判断曲面类型", "求旋转曲面方程", "求柱面方程", "画常见曲面草图"],
