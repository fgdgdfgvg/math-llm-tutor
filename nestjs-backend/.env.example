# ===========================================
# 高等数学 LLM 自动求解系统 — 后端环境变量配置
# ===========================================
# 用法：复制此文件为 .env 并填入真实值。
# 注意：.env 已被 .gitignore 忽略，**绝不提交真实密钥**。
#
# 占位值约定（消除"假可用"陷阱）：
#   - 密钥/口令类：一律留空（`KEY=`），缺失时启动期或运行时显式报错/降级，
#     而不是拿一个"看起来能用"的假值默默跑。
#   - URL / 端口 / 开关类：保留真实可用的开发默认值（连本机服务即可跑通）。

# ===========================================
# 数据库配置
# ===========================================
MONGODB_URI=mongodb://localhost:27017/math_tutor
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 生产环境必须更换，禁止沿用默认口令；留空则 Neo4j 连接降级
NEO4J_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# JWT 认证配置
# ===========================================
# 生产环境必须替换为 ≥32 字符的随机串；留空或使用默认值会导致启动期拒绝
JWT_SECRET=
# access token 时效（建议 15m，生产环境启动期会硬性拒绝超过 1h 的配置）
JWT_EXPIRATION=15m
# refresh token 时效（服务端存储、用一次即轮换 + 重用检测）
JWT_REFRESH_TTL=30d
# refresh token 重放宽容窗口（秒），多标签页并发刷新不至于互相踢下线
REFRESH_REPLAY_GRACE_SECONDS=30
# 登录防爆破：连续失败 5 次锁定 15 分钟
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
LOGIN_WINDOW_SECONDS=900

# ===========================================
# AI 模型 API 密钥（各 provider 独立凭据，缺失时智能体降级为本地规则引擎）
# ===========================================
# 安全约束：各 provider 的 key 只能发往其自身的 baseUrl。
# 不得跨服务商借用密钥——例如把 DeepSeek 官方 key 配给默认走 SiliconFlow 的
# provider，会导致 DeepSeek 密钥被发往第三方网关（历史 B1 缺陷，已修复）。

# DeepSeek API（OpenAI 兼容，官方 https://api.deepseek.com/v1）
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型名：deepseek-chat（默认）/ deepseek-reasoner（推理）/ deepseek-ai/DeepSeek-V3（SiliconFlow 命名）
AI_DEEPSEEK_MODEL=deepseek-chat

# OpenAI GPT API
AI_GPT_API_KEY=
AI_GPT_BASE_URL=https://api.openai.com/v1

# KatCoder API
AI_KATCODER_API_KEY=
AI_KATCODER_BASE_URL=https://api.katcoder.com/v1

# ModelScope 槽位（历史命名，实际经 SiliconFlow 网关跑 Qwen2.5-7B；
# 与 ai-models.service.ts 默认 baseUrl 一致，勿改回 ModelScope 官方端点，否则模型名不匹配）
AI_MODELSCOPE_API_KEY=
AI_MODELSCOPE_BASE_URL=https://api.siliconflow.cn/v1

# GLM API（GLM-4-9B，经 SiliconFlow 网关；与 ai-models.service.ts 默认 baseUrl 一致）
# 注意：此处 baseUrl 必须与代码默认值对齐，历史上曾误写为 ModelScope 端点，
# 导致 GLM 凭据被发往错误的第三方网关（跨服务商串用，第 7 轮 B2 已修复）。
AI_GLM_API_KEY=
AI_GLM_BASE_URL=https://api.siliconflow.cn/v1

# Qwen API（求解智能体；独立凭据，baseUrl 默认 SiliconFlow）
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://api.siliconflow.cn/v1
AI_QWEN_MODEL=Qwen/Qwen2.5-32B-Instruct

# HuggingFace API（规划智能体；独立凭据，baseUrl 默认 SiliconFlow）
AI_HUGGINGFACE_API_KEY=
AI_HUGGINGFACE_BASE_URL=https://api.siliconflow.cn/v1
AI_HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V3

# SiliconFlow 通用 token（Qwen / HuggingFace 的兜底，同服务商不算串用）
HF_TOKEN=

# ===========================================
# 服务端口配置
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# 跨域与反向代理（安全敏感）
# ===========================================
# 允许的跨域来源，逗号分隔。生产环境**未配置会拒绝启动**——
# 旧行为是未配置时反射任意 Origin + credentials，等于任何站点都能带用户凭据调 API。
# 含 80 端口来源：前端容器默认发布在 :80；漏了会出现"页面能打开、API 全挂"。
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:8080,http://localhost:5173

# 反向代理信任策略，**默认留空 = 完全不信任 X-Forwarded-For**（安全默认）。
# 语义同 Express trust proxy：1 = 信任最近一跳。
# 为什么默认关闭：X-Forwarded-For 可被客户端任意伪造，无条件采信等于让攻击者
# 自选 IP 绕过按 IP 的限流（实测随机伪造可 40/40 绕过 LLM 限流）。
# 部署在 nginx/网关之后必须显式设为 1，否则 req.ip 恒为网关地址、全站共用一个限流桶。
TRUST_PROXY=

# 生产环境默认不注册 Swagger 文档——它会完整枚举含管理端在内的全部端点。
# 仅在内网部署确需排查 API 时设为 true。
ENABLE_SWAGGER=

# ===========================================
# 接口限流
# ===========================================
# 普通接口：默认 60000ms 内最多 100 次
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# LLM 接口（命中 /agents/、/solve、/ai- 的路径，会实际消耗模型额度）：5 分钟内最多 20 次
RATE_LIMIT_LLM_WINDOW_MS=300000
RATE_LIMIT_LLM_MAX_REQUESTS=20

# ===========================================
# SymPy 计算服务配置
# ===========================================
SYMPY_SERVICE_URL=http://localhost:8000
# 后端调用 SymPy 计算端点的内部共享令牌（SymPy 侧校验 X-Internal-Token）。
# 生产环境必须设置并与 sympy-service 侧一致；留空时内部鉴权形同虚设。
SYMPY_INTERNAL_TOKEN=

# ===========================================
# 公式渲染服务配置
# ===========================================
FORMULA_RENDERER_URL=http://localhost:8080/render

# ===========================================
# 日志配置
# ===========================================
# 生产环境建议 info 或 warn，debug 会打印大量求解过程日志（控制生产日志量）。
LOG_LEVEL=debug
