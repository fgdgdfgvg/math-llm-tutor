# ===========================================
# 高等数学LLM自动求解系统 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入真实的密钥值
# 注意: .env 文件不应提交到版本控制系统

# ===========================================
# 数据库配置
# ===========================================
MONGODB_URI=mongodb://localhost:27017/math_tutor
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# JWT 认证配置
# ===========================================
JWT_SECRET=your_jwt_secret_key_change_in_production
# access token 时效（建议 15m，生产环境启动期会硬性拒绝超过 1h 的配置）
JWT_EXPIRATION=15m
# refresh token 时效（服务端存储、轮换 + 重用检测）
JWT_REFRESH_TTL=30d
# refresh token 重放宽容窗口（秒），多标签页并发刷新不至于互相踢下线
REFRESH_REPLAY_GRACE_SECONDS=30
# 登录防爆破：连续失败 5 次锁定 15 分钟
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
LOGIN_WINDOW_SECONDS=900

# ===========================================
# AI模型 API 密钥配置
# ===========================================

# DeepSeek API (OpenAI 兼容接口，官方 https://api.deepseek.com/v1)
AI_DEEPSEEK_API_KEY=your_deepseek_api_key
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型名（可选）：deepseek-chat（默认，通用对话）/ deepseek-reasoner（推理）
# 或第三方网关命名 deepseek-ai/DeepSeek-V3
AI_DEEPSEEK_MODEL=deepseek-chat

# OpenAI GPT API
AI_GPT_API_KEY=your_openai_api_key
AI_GPT_BASE_URL=https://api.openai.com/v1

# KatCoder API
AI_KATCODER_API_KEY=your_katcoder_api_key
AI_KATCODER_BASE_URL=https://api.katcoder.com/v1

# ModelScope API (魔搭社区)
AI_MODELSCOPE_API_KEY=your_modelscope_api_key
AI_MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ModelScope GLM API (智谱AI GLM-4.7-Flash)
AI_GLM_API_KEY=your_glm_api_key
AI_GLM_BASE_URL=https://api-inference.modelscope.cn/v1

# Hugging Face Token (用于Qwen和MiniMax模型)
HF_TOKEN=your_huggingface_token

# ===========================================
# 服务端口配置
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# 跨域与反向代理（安全敏感）
# ===========================================
# 允许的跨域来源，逗号分隔。生产环境**未配置会拒绝启动**
# （旧行为是未配置时反射任意 Origin + credentials，等于任何站点都能带用户凭据调 API）。
# 若前端通过 nginx 同源反代 /api/** 访问，浏览器不产生跨域，此项只需覆盖直连场景。
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# 反向代理信任策略，**默认留空 = 完全不信任 X-Forwarded-For**（安全默认）。
# 部署在 nginx/网关之后时必须显式开启，否则 req.ip 恒为网关地址，全站用户会
# 被算作同一个限流来源；而绝不能无条件信任该头——客户端可任意伪造，
# 实测随机伪造即可让 LLM 限流 40/40 全部放行。
# 取值语义同 Express：1 = 信任最近一跳；也可写 loopback / 网段等。
TRUST_PROXY=
# 生产环境默认不注册 Swagger 文档（它会完整枚举含管理端在内的全部端点）。
# 内网部署确需开放时设为 true。
ENABLE_SWAGGER=

# ===========================================
# 接口限流
# ===========================================
# 普通接口：默认 60000ms 内最多 100 次
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# LLM 接口（命中 /agents/、/solve、/ai- 的路径，会实际消耗模型额度）：5 分钟内最多 20 次
RATE_LIMIT_LLM_WINDOW_MS=300000
RATE_LIMIT_LLM_MAX_REQUESTS=20

# ===========================================
# SymPy 计算服务配置
# ===========================================
SYMPY_SERVICE_URL=http://localhost:8000
# 后端调用 SymPy 计算端点的内部共享密钥（SymPy 侧校验 X-Internal-Token）
SYMPY_INTERNAL_TOKEN=your_sympy_internal_token

# ===========================================
# 公式渲染服务配置
# ===========================================
FORMULA_RENDERER_URL=http://localhost:8080/render

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=debug
